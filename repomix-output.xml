RUN chmod +x /app/compiler.py

# Set entrypoint
ENTRYPOINT ["python3", "/app/compiler.py"]
EOF

# Step 5: Build and push container images
echo "🔨 Building and pushing container images..."
for lang in "${LANGUAGES[@]}"; do
