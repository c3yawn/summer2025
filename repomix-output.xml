FROM openjdk:17-jdk-slim

# Install Python and AWS CLI for S3 operations
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install boto3 for S3 operations
RUN pip3 install boto3

