# Multi-stage build for optimized JavaScript container
FROM node:18-alpine as builder

# Install Python and pip in builder stage
RUN apk add --no-cache python3 py3-pip

# Install boto3
RUN pip3 install --break-system-packages --target=/install boto3

# Final runtime stage - use Alpine for smaller size
FROM node:18-alpine as runtime

# Install only Python runtime (no pip/build tools)
RUN apk add --no-cache python3

# Copy boto3 installation from builder
COPY --from=builder /install /usr/lib/python3.11/site-packages

# Set environment variables for faster startup
ENV NODE_ENV=production
ENV PYTHONPATH=/usr/lib/python3.11/site-packages
ENV PYTHONUNBUFFERED=1

# Pre-warm Node.js and Python
RUN node -e "console.log('Node.js pre-warmed')" && \
    python3 -c "import boto3, json, os, sys, subprocess, time; print('Python dependencies pre-warmed')"

# Create working directory
WORKDIR /app

# Copy compiler script
COPY compiler.py /app/compiler.py
RUN chmod +x /app/compiler.py

# Use exec form for better performance
ENTRYPOINT ["python3", "/app/compiler.py"]
