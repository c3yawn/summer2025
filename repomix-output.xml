      InlineCode: |
        const { spawn } = require('child_process'), fs = require('fs'), path = require('path'), os = require('os');
        exports.handler = async (event, context) => {
            try {
                let body = event.body ? (typeof event.body === 'string' ? JSON.parse(event.body) : event.body) : event;
                const files = body.files || [];
                if (files.length === 0) return createResponse(false, '', 'No files provided');
                
                const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'js-'));
                let mainFilePath = null;
                try {
                    for (const fileData of files) {
                        const filename = fileData.filename || 'main.js';
                        const filePath = path.join(tempDir, filename);
                        fs.writeFileSync(filePath, fileData.content || '');
                        if (!mainFilePath) mainFilePath = filePath;
                    }
                    const result = await executeScript(path.basename(mainFilePath), tempDir);
                    return createResponse(result.success, result.output, result.error);
                } finally { try { fs.rmSync(tempDir, { recursive: true, force: true }); } catch (e) {} }
            } catch (error) { return createResponse(false, '', `Error: ${error.message}`); }
        };
        
        function executeScript(filename, workingDir) {
            return new Promise((resolve) => {
                const child = spawn('node', [filename], { cwd: workingDir });
                let stdout = '', stderr = '';
                child.stdout.on('data', (data) => stdout += data);
                child.stderr.on('data', (data) => stderr += data);
                const timeout = setTimeout(() => { child.kill(); resolve({ success: false, output: '', error: 'Timeout' }); }, 25000);
                child.on('close', (code) => { clearTimeout(timeout); resolve({ success: code === 0, output: stdout, error: stderr }); });
            });
        }
        
        function createResponse(success, output, error) {
            return { statusCode: 200, headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' }, body: JSON.stringify({ success, output, error }) };
        }

