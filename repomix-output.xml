package com.focusedai.codecompiler;

import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.core.SdkBytes;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.lambda.LambdaClient;
import software.amazon.awssdk.services.lambda.model.InvokeRequest;
import software.amazon.awssdk.services.lambda.model.InvokeResponse;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.util.*;

@RestController
@RequestMapping("/code")
public class LambdaCodeCompilerService {

    private final LambdaClient lambdaClient;
    private final ObjectMapper objectMapper;

    @Value("${aws.region:us-east-1}")
    private String awsRegion;

    public LambdaCodeCompilerService() {
        this.lambdaClient = LambdaClient.builder()
                .region(Region.US_EAST_1)
                .credentialsProvider(DefaultCredentialsProvider.create())
                .build();
        this.objectMapper = new ObjectMapper();
    }

    @PostMapping(value = "/execute", consumes = "multipart/form-data")
    public CodeExecutionResult executeCode(
            @RequestParam("javaFiles") MultipartFile[] codeFiles,
            @RequestParam("mainClassName") String mainClassName,
            @RequestParam("language") String language) {

        try {
            // Prepare files for Lambda
            List<Map<String, String>> files = new ArrayList<>();
            for (MultipartFile file : codeFiles) {
                if (!file.isEmpty()) {
                    Map<String, String> fileInfo = new HashMap<>();
                    fileInfo.put("filename", file.getOriginalFilename());
                    fileInfo.put("content", Base64.getEncoder().encodeToString(file.getBytes()));
                    files.add(fileInfo);
                }
            }

            // Prepare Lambda payload
            Map<String, Object> payload = new HashMap<>();
            payload.put("files", files);
            payload.put("mainClassName", mainClassName);

            // Determine Lambda function name
            String functionName = "code-compiler-" + language.toLowerCase();

            // Invoke Lambda function
            String payloadJson = objectMapper.writeValueAsString(payload);
            
            InvokeRequest invokeRequest = InvokeRequest.builder()
                    .functionName(functionName)
                    .payload(SdkBytes.fromString(payloadJson, StandardCharsets.UTF_8))
                    .build();

            InvokeResponse invokeResponse = lambdaClient.invoke(invokeRequest);

            // Parse Lambda response
            String responseJson = invokeResponse.payload().asString(StandardCharsets.UTF_8);
            
            if (invokeResponse.statusCode() != 200) {
                return new CodeExecutionResult(
                    "Lambda Error",
                    "",
                    "Lambda function returned status code: " + invokeResponse.statusCode(),
                    true
                );
            }

            // Parse the result from Lambda
            @SuppressWarnings("unchecked")
            Map<String, Object> lambdaResult = objectMapper.readValue(responseJson, Map.class);

            return new CodeExecutionResult(
                (String) lambdaResult.get("status"),
                (String) lambdaResult.getOrDefault("compilationErrors", ""),
                (String) lambdaResult.getOrDefault("programOutput", ""),
                (Boolean) lambdaResult.getOrDefault("hasError", false)
            );

        } catch (IOException e) {
            return new CodeExecutionResult(
                "Service Error",
                "",
                "Error processing files: " + e.getMessage(),
                true
            );
        } catch (Exception e) {
            return new CodeExecutionResult(
                "Lambda Invocation Error",
                "",
                "Error invoking Lambda function: " + e.getMessage(),
                true
            );
        }
    }

    @GetMapping("/health")
    public Map<String, String> health() {
        Map<String, String> health = new HashMap<>();
        health.put("status", "healthy");
        health.put("service", "Lambda Code Compiler");
        health.put("timestamp", new Date().toString());
        return health;
    }

    static class CodeExecutionResult {
        public String status;
        public String compilationErrors;
        public String programOutput;
        public boolean hasError;

        public CodeExecutionResult(String status, String compilationErrors, String programOutput, boolean hasError) {
            this.status = status;
            this.compilationErrors = compilationErrors;
            this.programOutput = programOutput;
            this.hasError = hasError;
        }
    }
}
